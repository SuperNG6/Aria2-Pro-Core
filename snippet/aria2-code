ARIA2_GIT_CODE() {
    # Pin to a specific upstream release tag so CI builds are reproducible
    # and immune to unrelated master commits (security backports, work for
    # the next minor, etc.). Bump this to a newer tag to upgrade aria2.
    local ARIA2_TAG="release-1.37.0"
    if [[ -d $ARIA2_CODE_DIR && -d $ARIA2_CODE_DIR/.git ]]; then
        cd $ARIA2_CODE_DIR
        git fetch --tags --depth=1 origin "refs/tags/${ARIA2_TAG}:refs/tags/${ARIA2_TAG}"
        git reset --hard "${ARIA2_TAG}"
    else
        rm -rf $ARIA2_CODE_DIR
        git clone https://github.com/aria2/aria2 $ARIA2_CODE_DIR \
            --depth=1 --branch "${ARIA2_TAG}"
        cd $ARIA2_CODE_DIR
    fi
}

ARIA2_RELEASE_CODE() {
    mkdir -p $ARIA2_CODE_DIR && cd $ARIA2_CODE_DIR
    curl -s 'https://api.github.com/repos/aria2/aria2/releases/latest' |
        grep 'browser_download_url.*[0-9]\.tar\.xz' | sed -e 's/^[[:space:]]*//' |
        cut -d ' ' -f 2 | xargs -I % curl -Ls -o - '%' | tar Jxvf - --strip-components=1
}

ARIA2_PATCH() {
    git apply $SCRIPT_DIR/patch/*.patch
}

ARIA2_CODE_GET() {
    ARIA2_GIT_CODE
    ARIA2_PATCH
    sed -E -i 's/AM_GNU_GETTEXT_VERSION\(([^)]*)\)/AM_GNU_GETTEXT_REQUIRE_VERSION(\1)/g' configure.ac
    autoreconf -fi || autoreconf -fiv
}
