 #endif // ENABLE_METALINK
 
+namespace {
+// Like checkParam<T> but treats a wrong-type parameter as "not present"
+// instead of throwing. Used for trailing optional parameters where the
+// strict mode would regress backward compatibility — upstream aria2 RPC
+// silently ignores unknown trailing parameters, and clients that happen
+// to send extras (Dicts, Strings, etc. for slots we did not previously
+// inspect) should keep working.
+template <typename T>
+const T* checkOptionalParam(const RpcRequest& req, size_t index)
+{
+  if (req.params->size() <= index) {
+    return nullptr;
+  }
+  return downcast<T>(req.params->get(index));
+}
+} // namespace
+
 namespace {
 std::unique_ptr<ValueBase> removeDownload(const RpcRequest& req,
                                           DownloadEngine* e, bool forceRemove)
 {
   const String* gidParam = checkRequiredParam<String>(req, 0);
+  const Bool* removeFilesParam = checkOptionalParam<Bool>(req, 1);
+  // Explicit param wins; otherwise fall back to the daemon default.
+  // The default is governed by --rpc-remove-files-default (default: false,
+  // matching upstream). Operators who want WebUIs that only have a single
+  // "delete" button to also delete files can flip the option to true.
+  bool removeFiles = removeFilesParam
+      ? removeFilesParam->val()
+      : e->getOption()->getAsBool(PREF_RPC_REMOVE_FILES_DEFAULT);
 
   a2_gid_t gid = str2Gid(gidParam);
   auto group = e->getRequestGroupMan()->findGroup(gid);
   if (group) {
     if (group->getState() == RequestGroup::STATE_ACTIVE) {
+      if (removeFiles) {
+        // Defer to ProcessStoppedRequestGroup: the running download holds
+        // open file handles, so synchronous unlink would race with the I/O
+        // loop. The mark is consumed when the group transitions to stopped.
+        e->getRequestGroupMan()->markRemoveFiles(gid);
+      }
       if (forceRemove) {
         group->setForceHaltRequested(true, RequestGroup::USER_REQUEST);
       }
@@ -405,6 +436,11 @@ std::unique_ptr<ValueBase> removeDownload(const RpcRequest& req,
     }
     else {
       if (group->isDependencyResolved()) {
+        if (removeFiles) {
+          // Paused/queued group: no active I/O, safe to delete synchronously
+          // before dropping the reservation.
+          e->getRequestGroupMan()->removeFilesForGroup(group);
+        }
         e->getRequestGroupMan()->removeReservedGroup(gid);
       }
       else {
@@ -1097,9 +1133,13 @@ std::unique_ptr<ValueBase>
 RemoveDownloadResultRpcMethod::process(const RpcRequest& req, DownloadEngine* e)
 {
   const String* gidParam = checkRequiredParam<String>(req, 0);
+  const Bool* removeFilesParam = checkOptionalParam<Bool>(req, 1);
+  bool removeFiles = removeFilesParam
+      ? removeFilesParam->val()
+      : e->getOption()->getAsBool(PREF_RPC_REMOVE_FILES_DEFAULT);
 
   a2_gid_t gid = str2Gid(gidParam);
-  if (!e->getRequestGroupMan()->removeDownloadResult(gid)) {
+  if (!e->getRequestGroupMan()->removeDownloadResult(gid, removeFiles)) {
     throw DL_ABORT_EX(fmt("Could not remove download result of GID#%s",
                           GroupId::toHex(gid).c_str()));
   }
