diff --git a/src/RequestGroupMan.cc b/src/RequestGroupMan.cc
index 425351b..7c3c342 100644
--- a/src/RequestGroupMan.cc
+++ b/src/RequestGroupMan.cc
@@ -40,6 +40,8 @@
 #include <sstream>
 #include <numeric>
 #include <algorithm>
+#include <functional>
+#include <set>
 #include <utility>
 
 #include "BtProgressInfoFile.h"
@@ -237,6 +239,91 @@ bool RequestGroupMan::removeReservedGroup(a2_gid_t gid)
   return reservedGroups_.remove(gid);
 }
 
+void RequestGroupMan::markRemoveFiles(a2_gid_t gid)
+{
+  removeFileGids_.insert(gid);
+}
+
+bool RequestGroupMan::takeRemoveFilesMark(a2_gid_t gid)
+{
+  return removeFileGids_.erase(gid) > 0;
+}
+
+void RequestGroupMan::removeFilesForGroup(
+    const std::shared_ptr<RequestGroup>& group)
+{
+  if (!group) {
+    return;
+  }
+  // Magnet metadata downloads have no on-disk file paths; skip.
+  if (group->inMemoryDownload()) {
+    return;
+  }
+  const auto& dctx = group->getDownloadContext();
+  if (!dctx) {
+    return;
+  }
+  // Control file first: this routes through BtProgressInfoFile so the BT
+  // case (<basePath>/<name>.aria2) and the HTTP case (<file>.aria2) are
+  // both handled correctly. Errors are non-fatal — the file may already
+  // be gone for completed downloads.
+  try {
+    group->removeControlFile();
+  }
+  catch (RecoverableException&) {
+    // ignore
+  }
+  // Track parent directories of every removed file so we can clean up
+  // empty subdirs left behind by multi-file torrents.
+  std::set<std::string, std::greater<std::string>> dirsToReap;
+  const std::string& basePath = dctx->getBasePath();
+  for (const auto& entry : dctx->getFileEntries()) {
+    if (!entry) {
+      continue;
+    }
+    const std::string& path = entry->getPath();
+    if (path.empty()) {
+      continue;
+    }
+    File f(path);
+    if (f.exists()) {
+      if (f.remove()) {
+        A2_LOG_INFO(fmt(MSG_FILE_REMOVED, path.c_str()));
+      }
+      else {
+        A2_LOG_INFO(fmt(MSG_FILE_COULD_NOT_REMOVED, path.c_str()));
+      }
+    }
+    // Record every ancestor directory strictly between the file and the
+    // base path. std::greater<> sorts deepest-first by lexicographic
+    // length-then-name, so child dirs are rmdir'd before their parents.
+    auto slash = path.find_last_of('/');
+    while (slash != std::string::npos) {
+      std::string parent = path.substr(0, slash);
+      if (parent.size() <= basePath.size() || parent == basePath) {
+        break;
+      }
+      dirsToReap.insert(parent);
+      slash = parent.find_last_of('/');
+    }
+  }
+  for (const auto& d : dirsToReap) {
+    File dir(d);
+    if (dir.exists() && dir.isDir()) {
+      dir.remove(); // best-effort, only succeeds when empty
+    }
+  }
+  // Finally try the torrent top-level dir. For the single-file HTTP case
+  // basePath equals the data file (already removed above) so this is a
+  // no-op; for BT torrents it removes the now-empty top-level directory.
+  if (!basePath.empty()) {
+    File base(basePath);
+    if (base.exists() && base.isDir()) {
+      base.remove();
+    }
+  }
+}
+
 namespace {
 
 void notifyDownloadEvent(DownloadEvent event,
@@ -354,6 +441,18 @@ public:
       const std::shared_ptr<DownloadContext>& dctx =
           group->getDownloadContext();
 
+      // Pull the removeFiles mark up front so every downstream decision
+      // (save vs. delete control file, post-download processing,
+      // addDownloadResult vs. skip) can take it into account in one place.
+      bool removeFilesRequested =
+          e_->getRequestGroupMan()->takeRemoveFilesMark(group->getGID());
+      // An explicit remove(gid, true) overrides a prior pause: if the user
+      // first paused then asked to remove with files, the remove intent
+      // wins — otherwise the mark would be silently dropped when the group
+      // gets pushed back onto reservedGroups_ by the pause path.
+      bool isPause =
+          group->isPauseRequested() && !removeFilesRequested;
+
       if (!group->isSeedOnlyEnabled()) {
         e_->getRequestGroupMan()->decreaseNumActive();
       }
@@ -369,13 +468,25 @@ public:
       }
       try {
         group->closeFile();
-        if (group->isPauseRequested()) {
+        if (isPause) {
           if (!group->isRestartRequested()) {
             A2_LOG_NOTICE(fmt(_("Download GID#%s paused"),
                               GroupId::toHex(group->getGID()).c_str()));
           }
           group->saveControlFile();
         }
+        else if (removeFilesRequested) {
+          // Skip both saveControlFile() and post-download processing: we
+          // are about to delete every artifact of this group. Saving the
+          // control file here would only force an immediate unlink in
+          // removeFilesForGroup() below; running post-download handlers
+          // (signature save, metalink extraction, nextGroups insertion)
+          // for a task the user just told us to discard is wasted work
+          // with potentially confusing side effects.
+          A2_LOG_NOTICE(
+              fmt(_("Download GID#%s removed with file deletion"),
+                  GroupId::toHex(group->getGID()).c_str()));
+        }
         else if (group->downloadFinished() &&
                  !group->getDownloadContext()->isChecksumVerificationNeeded()) {
           group->applyLastModifiedTimeToLocalFiles();
@@ -431,7 +542,7 @@ public:
       catch (RecoverableException& ex) {
         A2_LOG_ERROR_EX(EX_EXCEPTION_CAUGHT, ex);
       }
-      if (group->isPauseRequested()) {
+      if (isPause) {
         group->setState(RequestGroup::STATE_WAITING);
         reservedGroups_.push_front(group->getGID(), group);
         group->releaseRuntimeResource(e_);
@@ -455,7 +566,16 @@ public:
       }
       else {
         std::shared_ptr<DownloadResult> dr = group->createDownloadResult();
-        e_->getRequestGroupMan()->addDownloadResult(dr);
+        if (removeFilesRequested) {
+          e_->getRequestGroupMan()->removeFilesForGroup(group);
+          // Skip addDownloadResult entirely so the task does not appear
+          // in tellStopped, does not bump numStoppedTotal_, and does not
+          // cause max-download-result eviction of unrelated older
+          // entries. The user asked for the task to disappear.
+        }
+        else {
+          e_->getRequestGroupMan()->addDownloadResult(dr);
+        }
         executeStopHook(group, e_->getOption(), dr->result);
         group->releaseRuntimeResource(e_);
       }
@@ -909,8 +1029,39 @@ RequestGroupMan::findDownloadResult(a2_gid_t gid) const
   return downloadResults_.get(gid);
 }
 
-bool RequestGroupMan::removeDownloadResult(a2_gid_t gid)
+bool RequestGroupMan::removeDownloadResult(a2_gid_t gid, bool removeFiles)
 {
+  if (removeFiles) {
+    auto dr = downloadResults_.get(gid);
+    if (dr) {
+      // The control file has typically already been removed for completed
+      // downloads; for errored/aborted results that still have a .aria2 we
+      // try a per-entry suffix path (correct for HTTP single-file) on a
+      // best-effort basis.
+      for (const auto& entry : dr->fileEntries) {
+        if (!entry) {
+          continue;
+        }
+        const std::string& path = entry->getPath();
+        if (path.empty()) {
+          continue;
+        }
+        File f(path);
+        if (f.exists()) {
+          if (f.remove()) {
+            A2_LOG_INFO(fmt(MSG_FILE_REMOVED, path.c_str()));
+          }
+          else {
+            A2_LOG_INFO(fmt(MSG_FILE_COULD_NOT_REMOVED, path.c_str()));
+          }
+        }
+        File ctrl(path + ".aria2");
+        if (ctrl.exists()) {
+          ctrl.remove();
+        }
+      }
+    }
+  }
   return downloadResults_.remove(gid);
 }
 
