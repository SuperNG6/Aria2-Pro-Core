 src/RequestGroupMan.h       |  29 ++++++-
 src/RpcMethodImpl.cc        |  42 +++++++++-
 src/prefs.cc                |   3 +
 src/prefs.h                 |   2 +
 src/usage_text.h            |   7 ++
 7 files changed, 241 insertions(+), 8 deletions(-)

